# Copia este archivo a .env para desarrollo local (npm run dev).
DATABASE_URL=postgres://postgres@localhost:5432/aipex
APP_NAME=AIPEX DIGITAL
APP_PASSWORD=elige-una-contraseña-larga
SESSION_SECRET=cadena-aleatoria-larga

# IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Instagram (app de Meta con "Instagram API con inicio de sesión de Instagram")
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=cadena-aleatoria
# URL pública de la app. En Render no hace falta: se usa RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:3000
